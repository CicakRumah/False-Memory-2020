Dialogue: 0,0:01:14.58,0:01:17.15,italics,NARRATOR,0,0,0,,Ada dua cara\Nuntuk memperpanjang hidup.
Dialogue: 0,0:01:23.08,0:01:24.90,italics,NARRATOR,0,0,0,,Salah satunya dengan menonton film,
Dialogue: 0,0:01:28.47,0:01:29.48,main,FANG TANG,0,0,0,,Perhatikan.
Dialogue: 0,0:01:29.48,0:01:31.81,main,FANG TANG,0,0,0,,Target kembali memasuki\Nmode perlindungan diri.
Dialogue: 0,0:01:39.25,0:01:41.75,italics,NARRATOR,0,0,0,,Satunya lagi, dengan menjadi\NPengumpul Ingatan.
Dialogue: 0,0:01:44.12,0:01:47.31,main,FANG TANG,0,0,0,,BUG Man No. 55 ditemukan.\NSiapkan wadah ekstraksi.
Dialogue: 0,0:01:47.31,0:01:48.44,main,BAI ZHONG,0,0,0,,Siap, Bos!
Dialogue: 0,0:01:50.52,0:01:53.19,italics,NARRATOR,0,0,0,,Namun, karena sekarang bukan\Nmusim perekrutan,
Dialogue: 0,0:01:53.64,0:01:58.22,italics,NARRATOR,0,0,0,,aku belum akan membahas tunjangan\Nmenjadi pengumpul ingatan.
Dialogue: 0,0:01:59.21,0:02:00.83,italics,NARRATOR,0,0,0,,Yang ingin kubahas hari ini
Dialogue: 0,0:02:00.83,0:02:04.29,italics,NARRATOR,0,0,0,,adalah insiden yang biasa digunakan\Nuntuk mendidik anak baru seperti kalian,
Dialogue: 0,0:02:04.29,0:02:06.23,italics,NARRATOR,0,0,0,,"Kasus Pelarian Shi Yan."
Dialogue: 0,0:03:01.77,0:03:03.71,main,FANG TANG,0,0,0,,Ekstrasi dari BUG Source selesai.
Dialogue: 0,0:03:04.33,0:03:06.60,main,FANG TANG,0,0,0,,Wadah khusus untuk Shi Yan,\NBUG Man No. 55 siap.
Dialogue: 0,0:03:07.80,0:03:10.42,main,FANG TANG,0,0,0,,Selanjutnya, kita pakai ini\Nuntuk mendaur ulangnya.
Dialogue: 0,0:03:10.42,0:03:12.48,main,FANG TANG,0,0,0,,Namamu... Bai {\i1}Chong{\i0}?
Dialogue: 0,0:03:12.48,0:03:13.56,main,BAI ZHONG,0,0,0,,Bai {\i1}Zhong{\i0}!
Dialogue: 0,0:03:13.96,0:03:15.93,main,FANG TANG,0,0,0,,Oh, Bai Zhong.
Dialogue: 0,0:03:15.93,0:03:18.99,main,FANG TANG,0,0,0,,Kata mantan atasanmu,\Nkamu sangat rajin.
Dialogue: 0,0:03:18.99,0:03:21.40,main,FANG TANG,0,0,0,,Intinya, mulai sekarang kamu\Nbekerja di bawah bimbinganku.
Dialogue: 0,0:03:21.40,0:03:22.74,main,FANG TANG,0,0,0,,Namaku Fang Tang.
Dialogue: 0,0:03:23.52,0:03:25.27,main,FANG TANG,0,0,0,,Selamat datang di\NDepot Daur Ulang Ingatan,
Dialogue: 0,0:03:25.27,0:03:27.23,main,FANG TANG,0,0,0,,unit di bawah\NBiro Administrasi Ingatan.
Dialogue: 0,0:03:27.88,0:03:30.92,main,FANG TANG,0,0,0,,Semua yang menumpuk di sini\Nadalah entitas ingatan yang dibuang.
Dialogue: 0,0:03:30.92,0:03:35.25,main,FANG TANG,0,0,0,,Tapi pekerjaan di sini kebanyakan kerja fisik;\Nmendaur ulang, menyortir, dan sejenisnya.
Dialogue: 0,0:03:35.25,0:03:37.32,main,FANG TANG,0,0,0,,Sudah bertahun-tahun juga tidak ada\Nanak magang yang kemari.
Dialogue: 0,0:03:37.79,0:03:39.94,main,FANG TANG,0,0,0,,Meskipun pekerjaan\Ndi departemen kita sederhana,
Dialogue: 0,0:03:39.94,0:03:41.61,main,FANG TANG,0,0,0,,tapi sering terjadi keadaan darurat.
Dialogue: 0,0:03:41.61,0:03:43.27,main,FANG TANG,0,0,0,,Jadi, izinkan mengulangi kembali\Npoin-poinnya.
Dialogue: 0,0:03:43.83,0:03:45.88,main,FANG TANG,0,0,0,,Tugas utama kita ada dua.
Dialogue: 0,0:03:45.88,0:03:48.71,main,FANG TANG,0,0,0,,Pertama, mengekstraksi ingatan tidak penting\Nyang berlebih dari makhluk hidup.
Dialogue: 0,0:03:48.71,0:03:51.44,main,FANG TANG,0,0,0,,Meskipun batas kapasitas penyimpanan\Notak manusia belum jelas,
Dialogue: 0,0:03:51.44,0:03:54.33,main,FANG TANG,0,0,0,,tapi manusia selalu mencari\Ncara penyimpanan yang lebih efisien.
Dialogue: 0,0:03:54.33,0:03:57.27,main,FANG TANG,0,0,0,,Dan Pengekstrak Ingatan\Nyang baru saja kugunakan ini,
Dialogue: 0,0:03:57.27,0:03:59.57,main,FANG TANG,0,0,0,,merupakan alat bantu\Nyang dikembangkan oleh biro kita.
Dialogue: 0,0:04:00.65,0:04:02.04,main,FANG TANG,0,0,0,,Dalam keadaan normal,
Dialogue: 0,0:04:02.04,0:04:05.58,main,FANG TANG,0,0,0,,alat ini otomatis membuang ingatan sepele\Nagar bisa mengingat hal baru.
Dialogue: 0,0:04:06.88,0:04:10.29,main,FANG TANG,0,0,0,,Tentu saja, jika ingatan yang diekstraksi\Nhancur di sini,
Dialogue: 0,0:04:10.29,0:04:11.65,main,FANG TANG,0,0,0,,maka ingatan itu\Nakan lenyap selamanya.
Dialogue: 0,0:04:14.01,0:04:15.92,italics,FANG TANG,0,0,0,,Dia dengerin enggak, sih?
Dialogue: 0,0:04:17.38,0:04:19.82,main,FANG TANG,0,0,0,,Tugas kedua kita adalah\Nmendaur ulang...
Dialogue: 0,0:04:20.17,0:04:20.85,main,FANG TANG,0,0,0,,BUG Man.
Dialogue: 0,0:04:21.58,0:04:22.52,main,FANG TANG,0,0,0,,Dalam sepuluh tahun terakhir,
Dialogue: 0,0:04:22.52,0:04:24.96,main,FANG TANG,0,0,0,,kasus kekerasan yang melibatkan\NBUG Man terus meningkat.
Dialogue: 0,0:04:24.96,0:04:27.33,main,FANG TANG,0,0,0,,Asal-usul mereka\Nmasih belum pasti,
Dialogue: 0,0:04:27.33,0:04:29.21,main,FANG TANG,0,0,0,,tapi teori yang umum\Nsaat ini adalah...
Dialogue: 0,0:04:29.21,0:04:32.21,main,FANG TANG,0,0,0,,BUG Man tercipta dari ingatan orang-orang\Nyang memiliki kondisi fisik khusus,
Dialogue: 0,0:04:32.21,0:04:35.06,main,FANG TANG,0,0,0,,yang mewujud karena emosi kuat\Nyang melekat pada ingatan tersebut.
Dialogue: 0,0:04:35.50,0:04:37.83,main,FANG TANG,0,0,0,,Biasanya, kami menyebut orang-orang itu\Nsebagai "BUG Source".
Dialogue: 0,0:04:38.33,0:04:41.15,main,FANG TANG,0,0,0,,Kami memulai mengintervensi\NBUG Man melalui BUG Source mereka.
Dialogue: 0,0:04:41.15,0:04:44.39,main,FANG TANG,0,0,0,,Ada 93 BUG Man\Nyang tercatat sejauh ini.
Dialogue: 0,0:04:44.39,0:04:46.60,main,FANG TANG,0,0,0,,Mereka semua memicu kekacauan.
Dialogue: 0,0:04:47.13,0:04:51.00,main,FANG TANG,0,0,0,,Misalnya, mencampur aduk ingatan yang tidak\Nsaling berhubungan layaknya kabel bersilangan.
Dialogue: 0,0:04:50.17,0:04:51.00,top,BAI ZHONG,0,0,0,,{\i1}Dicampur aduk{\i0}?
Dialogue: 0,0:04:51.29,0:04:53.85,main,FANG TANG,0,0,0,,Atau memicu déjà vu hebat,\Nhingga mengaburkan batas nyata dan palsu.
Dialogue: 0,0:04:54.83,0:04:55.81,main,FANG TANG,0,0,0,,Dalam kasus ekstrem,
Dialogue: 0,0:04:55.81,0:04:59.79,main,FANG TANG,0,0,0,,arah hidup seseorang bahkan\Nbisa berubah secara mendadak.
Dialogue: 0,0:04:59.79,0:05:01.03,main,FANG TANG,0,0,0,,Kamu pasti sudah tahu soal ini.
Dialogue: 0,0:05:01.03,0:05:04.21,main,FANG TANG,0,0,0,,Untungnya, sebagian besar dari mereka\Nsudah berhasil kami daur ulang.
Dialogue: 0,0:05:04.21,0:05:08.50,main,FANG TANG,0,0,0,,Shi Yan, yang lahir dari BUG Source ini,\Nadalah salah satu BUG Man yang tersisa.
Dialogue: 0,0:05:08.50,0:05:10.79,main,FANG TANG,0,0,0,,Menghadapinya di hari pertamamu\Nmungkin akan sedikit merepotkan.
Dialogue: 0,0:05:10.79,0:05:12.25,main,FANG TANG,0,0,0,,Tapi hanya sedikit saja.
Dialogue: 0,0:05:14.42,0:05:15.75,main,FANG TANG,0,0,0,,Hmm, kondisinya stabil.
Dialogue: 0,0:05:16.48,0:05:18.71,main,FANG TANG,0,0,0,,Bai Zhong,\Nturunkan tuas itu.
Dialogue: 0,0:05:18.71,0:05:20.40,main,FANG TANG,0,0,0,,Kita resmi memulai\Nproses daur ulang.
Dialogue: 0,0:05:20.64,0:05:21.73,main,FANG TANG,0,0,0,,Tolong berhati-hati!
Dialogue: 0,0:05:29.04,0:05:31.50,italics,NANZHU,0,0,0,,Sejak kecil,\Naku selalu dirundung.
Dialogue: 0,0:05:32.21,0:05:33.37,italics,NANZHU,0,0,0,,Aku benci perkelahian.
Dialogue: 0,0:05:33.79,0:05:37.04,italics,NANZHU,0,0,0,,Aku tak pernah paham kenapa orang-orang\Nselalu mengincar dan mencari masalah denganku...
Dialogue: 0,0:05:38.81,0:05:40.54,italics,NANZHU,0,0,0,,...sampai akhirnya Shi Yan muncul.
Dialogue: 0,0:05:41.00,0:05:43.33,italics,NANZHU,0,0,0,,Sejak ada dia,\Nhidupku perlahan terasa lebih mudah.
Dialogue: 0,0:06:02.12,0:06:04.07,italics,NANZHU,0,0,0,,Untungnya,\Nkami selalu satu sekolah.
Dialogue: 0,0:06:05.46,0:06:07.87,italics,NANZHU,0,0,0,,Setiap kali aku dirundung,\Ndia pasti selalu muncul.
Dialogue: 0,0:06:10.21,0:06:13.53,italics,NANZHU,0,0,0,,Shi Yan tidak terlalu tinggi,\Ntapi makannya banyak.
Dialogue: 0,0:06:13.53,0:06:16.34,italics,NANZHU,0,0,0,,Dia sering main di luar,\Njadi kulitnya selalu berwarna sawo matang.
Dialogue: 0,0:06:16.79,0:06:18.35,italics,NANZHU,0,0,0,,Aku tidak suka manis.
Dialogue: 0,0:06:18.35,0:06:20.08,italics,NANZHU,0,0,0,,Aku masih ingat saat ulang tahunku...
Dialogue: 0,0:06:20.08,0:06:24.00,italics,NANZHU,0,0,0,,dia melahap habis semua kue\Nyang disiapkan keluargaku.
Dialogue: 0,0:06:24.96,0:06:27.16,italics,NANZHU,0,0,0,,Dia juga yang mengajariku\Ncara naik sepeda.
Dialogue: 0,0:06:27.16,0:06:29.92,italics,NANZHU,0,0,0,,Setelah itu, kami sering\Nbersepeda bersama.
Dialogue: 0,0:06:32.08,0:06:34.12,italics,NANZHU,0,0,0,,Shi Yan selalu tampak tanpa beban.
Dialogue: 0,0:06:34.73,0:06:37.95,italics,NANZHU,0,0,0,,Entah apa yang selalu\Nada di pikirannya.
Dialogue: 0,0:06:52.00,0:06:55.58,italics,NANZHU,0,0,0,,Tapi, dia selalu menjadi sosok\Nyang sangat ingin kutiru.
Dialogue: 0,0:06:56.29,0:06:58.44,italics,NANZHU,0,0,0,,Dia orangnya lugas dan tegas,
Dialogue: 0,0:06:58.44,0:07:00.81,italics,NANZHU,0,0,0,,tidak pernah ragu saat bertindak,
Dialogue: 0,0:07:00.81,0:07:02.10,italics,NANZHU,0,0,0,,dan aku tak pernah melihatnya takut.
Dialogue: 0,0:07:04.25,0:07:07.08,italics,NANZHU,0,0,0,,Berkali-kali,\Ndia menyelamatkanku dari kesulitan.
Dialogue: 0,0:07:07.79,0:07:09.89,italics,NANZHU,0,0,0,,Lama-kelamaan, selama ada dia,
Dialogue: 0,0:07:10.58,0:07:12.60,italics,NANZHU,0,0,0,,tidak ada lagi\Nyang berani menggangguku.
Dialogue: 0,0:07:15.07,0:07:17.96,italics,NANZHU,0,0,0,,Dia seperti\Nselalu punya waktu luang.
Dialogue: 0,0:07:18.46,0:07:22.19,italics,NANZHU,0,0,0,,Tiap kali diajak main,\Ndia selalu meluangkan waktunya.
Dialogue: 0,0:07:23.09,0:07:25.88,italics,NANZHU,0,0,0,,Meskipun tidak banyak\Nhiburan di kota ini,
Dialogue: 0,0:07:25.88,0:07:29.19,italics,NANZHU,0,0,0,,menghabiskan waktu bersamanya\Nselalu terasa sangat menyenangkan.
Dialogue: 0,0:07:33.67,0:07:36.68,main,NANZHU,0,0,0,,Liburan cepat banget habis,\Nmales banget sekolah rasanya.
Dialogue: 0,0:07:36.68,0:07:38.58,main,NANZHU,0,0,0,,Jam pelajaran serasa lama sekali...
Dialogue: 0,0:07:40.42,0:07:44.52,main,NANZHU,0,0,0,,Tapi kalau dipikir-pikir,\Nperjalanan hidup ini singkat juga.
Dialogue: 0,0:07:45.08,0:07:49.02,main,NANZHU,0,0,0,,Kalau kita hidup sampai umur 70 tahun,\Nkita sudah menghabiskan hampir seperempatnya.
Dialogue: 0,0:07:50.50,0:07:52.67,main,NANZHU,0,0,0,,Ngeri juga\Nkalau dipikir seperti itu.
Dialogue: 0,0:07:54.13,0:07:54.85,main,NANZHU,0,0,0,,Ah, lihat!
Dialogue: 0,0:08:07.04,0:08:09.85,main,FANG TANG,0,0,0,,Bai Zhong,\Nmenjauhlah!
Dialogue: 0,0:08:09.85,0:08:11.92,main,FANG TANG,0,0,0,,Kekuatannya meningkat drastis\Nakibat pengaruh BUG Source!
Dialogue: 0,0:09:33.54,0:09:35.85,main,BAI ZHONG,0,0,0,,Lho? Harusnya tidak begini.
Dialogue: 0,0:09:35.85,0:09:37.17,main,BAI ZHONG,0,0,0,,Obat biusnya\Nsama sekali tidak mempan!
Dialogue: 0,0:09:37.17,0:09:39.77,main,NANZHU,0,0,0,,Kamu kelihatan familier...
Dialogue: 0,0:09:38.70,0:09:39.77,top,BAI ZHONG,0,0,0,,Iyakah?
Dialogue: 0,0:09:40.46,0:09:41.39,main,NANZHU,0,0,0,,Kepalaku sakit...
Dialogue: 0,0:09:41.85,0:09:43.04,main,NANZHU,0,0,0,,Aku di mana?
Dialogue: 0,0:09:43.04,0:09:46.54,main,BAI ZHONG,0,0,0,,Otakmu sedang bermasalah,\Nkami sedang mengobatinya.
Dialogue: 0,0:09:45.42,0:09:46.54,top,NANZHU,0,0,0,,Mereka sedang apa?
Dialogue: 0,0:09:47.21,0:09:48.42,main,BAI ZHONG,0,0,0,,Bosku sedang menangkapnya.
Dialogue: 0,0:09:48.42,0:09:51.33,main,NANZHU,0,0,0,,Apa? Sebenarnya ini di mana, sih?!
Dialogue: 0,0:09:51.33,0:09:53.48,main,BAI ZHONG,0,0,0,,Aku juga baru di sini,\Njadi tidak bisa menjelaskan banyak.
Dialogue: 0,0:09:53.96,0:09:56.42,main,BAI ZHONG,0,0,0,,Intinya, dia itu BUG Man\Nyang kamu ciptakan sendiri.
Dialogue: 0,0:09:56.42,0:09:59.13,main,BAI ZHONG,0,0,0,,Karena dia sering menyusup ke dunia nyata\Ndan mengacaukan ingatanmu,
Dialogue: 0,0:09:59.13,0:10:02.15,main,BAI ZHONG,0,0,0,,dia bisa menjadi ancaman besar nantinya,\Nmaka dari itu dia harus ditangkap.
Dialogue: 0,0:10:00.48,0:10:02.15,top,NANZHU,0,0,0,,Pelan-pelan bicaranya!
Dialogue: 0,0:10:02.50,0:10:05.43,main,BAI ZHONG,0,0,0,,Singkatnya, sosok '{\i1}dia{\i0}' di dunia nyata\Nsudah tidak ada lagi,
Dialogue: 0,0:10:05.43,0:10:08.00,main,BAI ZHONG,0,0,0,,tapi kamu mewujudkannya kembali\Nsecara paksa dari ingatanmu sendiri.
Dialogue: 0,0:10:09.46,0:10:11.59,main,BAI ZHONG,0,0,0,,Tapi hebat juga,
Dialogue: 0,0:10:12.17,0:10:16.73,main,BAI ZHONG,0,0,0,,BUG Source pecundang sepertimu\Nbisa menciptakan BUG Man sekuat ini.
Dialogue: 0,0:10:18.04,0:10:21.74,italics,NANZHU,0,0,0,,Momen terpenting dalam hidup\Nhanya ditentukan oleh beberapa pilihan saja.
Dialogue: 0,0:10:23.04,0:10:25.56,italics,NANZHU,0,0,0,,Mungkin karena\Nsifatku yang peragu,
Dialogue: 0,0:10:26.24,0:10:27.77,italics,NANZHU,0,0,0,,aku jadi sulit berteman.
Dialogue: 0,0:10:30.58,0:10:33.38,italics,NANZHU,0,0,0,,Saat kelas satu,\Nwaktu karyawisata sekolah,
Dialogue: 0,0:10:34.42,0:10:37.13,italics,NANZHU,0,0,0,,aku malah\Ntertinggal di perkemahan.
Dialogue: 0,0:10:35.75,0:10:37.13,flashbacktop,NANZHU,0,0,0,,Tunggu aku!
Dialogue: 0,0:10:38.89,0:10:41.36,italics,NANZHU,0,0,0,,Alhasil, aku harus bersepeda\Npuluhan kilometer untuk pulang.
Dialogue: 0,0:10:45.83,0:10:49.29,italics,NANZHU,0,0,0,,Teman sekelas terkadang kesal\Nkalau hasil foto mereka jelek.
Dialogue: 0,0:10:51.04,0:10:54.64,italics,NANZHU,0,0,0,,Tetapi, wajahku bahkan tidak ada\Ndi dinding foto.
Dialogue: 0,0:10:55.88,0:10:58.00,italics,NANZHU,0,0,0,,Di reuni kelas\Npuluhan tahun kemudian,
Dialogue: 0,0:10:58.00,0:11:00.19,italics,NANZHU,0,0,0,,kurasa tidak akan ada yang ingat\Nuntuk mengundangku.
Dialogue: 0,0:11:00.88,0:11:02.23,italics,NANZHU,0,0,0,,Toh, aku sudah dilupakan.
Dialogue: 0,0:11:02.83,0:11:05.67,italics,NANZHU,0,0,0,,Bukannya itu sama saja aku\Nsudah tidak ada bagi mereka?
Dialogue: 0,0:11:06.72,0:11:10.90,italics,NANZHU,0,0,0,,Sejak hari karyawisata itu,\Naku pun mulai memotret sendiri.
Dialogue: 0,0:11:11.62,0:11:13.71,italics,NANZHU,0,0,0,,Ada banyak hal\Nyang tidak ingin kulupakan,
Dialogue: 0,0:11:13.71,0:11:16.54,italics,NANZHU,0,0,0,,dan foto jauh lebih tepercaya\Ndaripada ingatan manusia.
Dialogue: 0,0:11:17.58,0:11:19.40,main,BAI ZHONG,0,0,0,,Sepertinya di sebelah sana\Nhampir selesai.
Dialogue: 0,0:11:20.04,0:11:21.50,main,BAI ZHONG,0,0,0,,Selesai, proses daur ulang beres.
Dialogue: 0,0:11:22.29,0:11:24.25,main,BAI ZHONG,0,0,0,,Kembalilah tidur sebentar!
Dialogue: 0,0:11:31.63,0:11:33.00,main,FANG TANG,0,0,0,,Bai Zhong!
Dialogue: 0,0:11:33.00,0:11:34.57,main,FANG TANG,0,0,0,,Kamu tidak membaca panduannya?!
Dialogue: 0,0:11:34.92,0:11:37.35,main,FANG TANG,0,0,0,,Menggangu BUG Source di sini\Nakan sangat mengganggu transmisi kita!
Dialogue: 0,0:11:41.17,0:11:42.65,main,FANG TANG,0,0,0,,Ingatannya mulai meluap hebat.
Dialogue: 0,0:11:42.65,0:11:43.83,main,FANG TANG,0,0,0,,Ini gawat sekali.
Dialogue: 0,0:12:36.13,0:12:37.38,main,FANG TANG,0,0,0,,Hentikan.
Dialogue: 0,0:12:37.38,0:12:38.92,main,FANG TANG,0,0,0,,Ini tidak ada baiknya bagi dia.
Dialogue: 0,0:12:39.46,0:12:42.38,main,FANG TANG,0,0,0,,Kalau terus mengulur waktu,\Naku terpaksa memusnahkanmu di tempat.
Dialogue: 0,0:12:44.34,0:12:46.42,main,FANG TANG,0,0,0,,Bantuanmu takkan\Nada gunanya bagi dia.
Dialogue: 0,0:12:46.42,0:12:49.75,main,FANG TANG,0,0,0,,Lagi pula, kamu sudah tidak ada lagi\Ndi dunia nyata, No. 55.
Dialogue: 0,0:14:06.29,0:14:08.74,main,FANG TANG,0,0,0,,No. 55, sampai di sini saja!
Dialogue: 0,0:14:34.26,0:14:35.39,main,NANZHU,0,0,0,,Atap?
Dialogue: 0,0:14:36.79,0:14:39.32,italics,NANZHU,0,0,0,,Apa aku tertidur di atap lagi?
Dialogue: 0,0:14:43.63,0:14:46.08,italics,NANZHU,0,0,0,,Cuaca di sini selalu menyenangkan.
Dialogue: 0,0:14:49.19,0:14:50.52,italics,NANZHU,0,0,0,,Aku ingat sekarang...
Dialogue: 0,0:14:51.41,0:14:54.42,italics,NANZHU,0,0,0,,Shi Yan sudah tiada\Nsemenjak musim panas lalu.
Dialogue: 0,0:14:56.09,0:15:00.96,italics,NANZHU,0,0,0,,Sejak saat itu, apa semuanya\Nhanya halusinasiku belaka?
Dialogue: 0,0:15:03.42,0:15:05.69,main,FANG TANG,0,0,0,,Bagus, daur ulang BUG Man\Nberjalan lancar.
Dialogue: 0,0:15:08.50,0:15:11.54,italics,NANZHU,0,0,0,,Tidak, aku tidak boleh\Nterus berada di sini.
Dialogue: 0,0:15:13.67,0:15:15.50,italics,NANZHU,0,0,0,,Tapi tak ada jalan keluar dari sini.
Dialogue: 0,0:15:16.33,0:15:18.94,italics,NANZHU,0,0,0,,Kalaupun bisa keluar,\Nlalu harus bagaimana?
Dialogue: 0,0:15:19.54,0:15:22.23,italics,NANZHU,0,0,0,,Nilai pelajaran, rundungan,
Dialogue: 0,0:15:22.23,0:15:25.43,italics,NANZHU,0,0,0,,bersosialisasi,\Nrencana masa depan...
Dialogue: 0,0:15:25.43,0:15:27.17,italics,NANZHU,0,0,0,,Tak ada satu pun\Nyang kupersiapkan.
Dialogue: 0,0:15:28.48,0:15:29.77,italics,NANZHU,0,0,0,,Kalaupun keluar,
Dialogue: 0,0:15:30.73,0:15:33.48,italics,NANZHU,0,0,0,,aku takkan bisa\Nmelakukan apa-apa sendirian.
Dialogue: 0,0:16:13.23,0:16:15.81,main,NANZHU,0,0,0,,Kembalikan kameraku!
Dialogue: 0,0:16:22.23,0:16:25.08,italics,NARRATOR,0,0,0,,Perubahan terkecil\Nsekalipun di dalam hati
Dialogue: 0,0:16:25.08,0:16:28.90,italics,NARRATOR,0,0,0,,cukup untuk memicu riak besar\Ndi sepanjang perjalanan hidup.
Dialogue: 0,0:16:29.50,0:16:31.92,italics,NARRATOR,0,0,0,,Oleh karena itu,\Npengelola ingatan...
Dialogue: 0,0:16:31.92,0:16:36.08,italics,NARRATOR,0,0,0,,merupakan pekerjaan paling berisiko\Ndan terkacau di dunia.
Dialogue: 0,0:16:40.14,0:16:41.77,main,FANG TANG,0,0,0,,No. 55, Shi Yan...
Dialogue: 0,0:16:41.77,0:16:43.17,main,FANG TANG,0,0,0,,Daur ulang selesai.
Dialogue: 0,0:16:44.22,0:16:47.06,main,BAI ZHONG,0,0,0,,Hei, Bos! Apa aku\Njuga ada di dalam sana?
Dialogue: 0,0:16:47.06,0:16:48.38,main,FANG TANG,0,0,0,,Entahlah.
Dialogue: 0,0:16:49.80,0:16:51.27,main,FANG TANG,0,0,0,,…Sebagai BUG,
Dialogue: 0,0:16:51.27,0:16:54.01,main,FANG TANG,0,0,0,,dia jelas punya\Npilihan yang lebih baik.
Dialogue: 0,0:16:52.94,0:16:56.23,top,BAI ZHONG,0,0,0,,Jadi, kemampuan Shi Yan itu\Nmembaurkan antara nyata dan palsu?
Dialogue: 0,0:16:57.32,0:16:59.08,main,BAI ZHONG,0,0,0,,Tapi dia hebat juga.
Dialogue: 0,0:16:59.08,0:17:01.82,main,BAI ZHONG,0,0,0,,Hebat juga dia sampai bisa\Nmemengaruhi realitas pada akhirnya.
Dialogue: 0,0:17:02.67,0:17:03.73,main,BAI ZHONG,0,0,0,,Apa boleh dibiarin gitu aja?
Dialogue: 0,0:17:04.15,0:17:06.76,main,FANG TANG,0,0,0,,Bai Zhong,\Nkamu masih pemula.
Dialogue: 0,0:17:07.13,0:17:11.04,main,FANG TANG,0,0,0,,Bagi kita, baik atau buruk,\Nnyata atau palsu, semuanya tidak ada artinya.
Dialogue: 0,0:17:11.04,0:17:12.17,main,FANG TANG,0,0,0,,Sudahlah,
Dialogue: 0,0:17:12.17,0:17:15.29,main,FANG TANG,0,0,0,,baru sehari magang,\Nrekorku hampir saja hancur.
Dialogue: 0,0:17:15.29,0:17:20.77,main,BAI ZHONG,0,0,0,,Ah… hehe, Boss…\Nitu berlebihan sekali!
